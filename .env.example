# Copy to .env when you want to connect a model. Keep disabled until configured.
LLM_ENABLED=false
LLM_PROVIDER=openai-compatible
# Service root including the API version, e.g. https://api.example.com/v1
# /chat/completions is appended unless already present. HTTPS required except localhost.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=45000
# Use max_tokens for services that do not accept max_completion_tokens.
LLM_TOKEN_PARAMETER=max_completion_tokens

# Optional private HTTPS deployment. Both values are required together.
# Leave empty for local-only use. Never expose the local mode through a proxy.
AFTERWORD_PUBLIC_ORIGIN=
# Generate with npm run password:hash. Keep the hash single-quoted.
AFTERWORD_PASSWORD_HASH=
HOST=127.0.0.1
PORT=3210
